    {
        "id": "eb57737f587e7bb3",
        "type": "function",
        "z": "b02fa07905eab5c5",
        "name": "function 1",
        "func": "\n // CONFIGURACAO CALLMEBOT\n// Coloque seu numero com DDI 55 + DDD + numero\nconst telefone = \"5511987039785\";\nconst apiKey = \"3019713\";\n\n// RECEBER OS DADOS MQTT\nlet dados = msg.payload;\n\n// Converter JSON se chegar como texto\nif (typeof dados === \"string\") {\n    try {\n        dados = JSON.parse(dados);\n    } catch (erro) {\n        node.error(\"JSON MQTT invalido\", msg);\n        return null;\n    }\n}\n\n// VERIFICAR OS VALORES\nif (!dados ||\n    dados.pressao === undefined ||\n    dados.temperatura === undefined) {\n    node.error(\"Pressao ou temperatura ausente\", msg);\n    return null;\n}\n\n// MONTAR MENSAGEM WHATSAPP\nconst texto =\n    \"*Leitura do ESP32*\\n\\n\" +\n    \"Pressao: \" + dados.pressao + \" kPa\\n\" +\n    \"Temperatura: \" + dados.temperatura + \" °C\\n\\n\" +\n    \"Leitura enviada pelo botao GPIO 27.\";\n\n// CODIFICAR A MENSAGEM PARA URL\nconst mensagem = encodeURIComponent(texto);\n\n// MONTAR A URL DA API CALLMEBOT\nmsg.url =\n    \"https://api.callmebot.com/whatsapp.php\" +\n    \"?phone=\" + encodeURIComponent(telefone) +\n    \"&text=\" + mensagem +\n    \"&apikey=\" + encodeURIComponent(apiKey);\n\n// PREPARAR REQUISICAO HTTP\nmsg.method = \"GET\";\ndelete msg.payload;\n\n// ENVIAR PARA O PROXIMO NO\nreturn msg;\n",
